    "/v1/diagnostics/probe": {
      "post": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Latency Probe",
        "description": "Execute end-to-end latency measurement probe through full middleware stack.",
        "operationId": "latency_probe_v1_diagnostics_probe_post",
