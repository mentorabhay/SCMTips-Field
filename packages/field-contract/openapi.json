    "/v1/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get System Status",
        "description": "Return system readiness, component health, and core compatibility matrix.",
        "operationId": "get_system_status_v1_system_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
