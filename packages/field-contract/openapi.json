  "components": {
    "schemas": {
      "CompatItem": {
        "properties": {
          "component": {
            "type": "string",
            "title": "Component"
          },
          "current_version": {
            "type": "string",
            "title": "Current Version"
          },
          "target_contract": {
            "type": "string",
            "title": "Target Contract"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "component",
          "current_version",
          "target_contract",
          "status"
        ],
        "title": "CompatItem"
      },
      "DeviceRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "serial_no": {
            "type": "string",
            "title": "Serial No"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "kind",
          "serial_no",
          "model",
          "status",
          "version",
          "created_at",
          "updated_at"
        ],
        "title": "DeviceRecord"
      },
      "DeviceRegister": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "phone or glasses"
          },
          "serial_no": {
            "type": "string",
            "title": "Serial No"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "os_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Os Version"
          },
          "app_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "serial_no",
          "model"
        ],
        "title": "DeviceRegister"
      },
      "ExchangeRequest": {
        "properties": {
          "device_token": {
            "type": "string",
            "title": "Device Token",
            "description": "Core P10 device token"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          }
        },
        "type": "object",
        "required": [
          "device_token"
        ],
        "title": "ExchangeRequest"
      },
      "ExchangeResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "default": 3600
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "site_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Site Ids"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "roles",
          "permissions",
          "tenant_id",
          "site_ids"
        ],
        "title": "ExchangeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "field-api"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LocationCreate": {
        "properties": {
          "site_id": {
            "type": "string",
            "title": "Site Id"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "zone, aisle, rack, level, position, tower, sector"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{1,24}$",
            "title": "Code"
          },
          "erp_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Erp Ref"
          },
          "erp_ref_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Erp Ref Type"
          }
        },
        "type": "object",
        "required": [
          "site_id",
          "kind",
          "code"
        ],
        "title": "LocationCreate"
      },
      "LocationRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "site_id": {
            "type": "string",
            "title": "Site Id"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "depth": {
            "type": "integer",
            "title": "Depth"
          },
          "erp_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
