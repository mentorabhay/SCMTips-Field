    "/v1/materials": {
      "get": {
        "tags": [
          "Materials"
        ],
        "summary": "Search Materials",
        "description": "Search cached materials by plant, number or description with cursor pagination.",
        "operationId": "search_materials_v1_materials_get",
        "parameters": [
          {
            "name": "plant",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Plant filter e.g. 1010",
              "title": "Plant"
            },
            "description": "Plant filter e.g. 1010"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search term for material no or description",
              "title": "Q"
            },
            "description": "Search term for material no or description"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque keyset cursor from prior response",
              "title": "Cursor"
            },
            "description": "Opaque keyset cursor from prior response"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Page size limit (1..200)",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page size limit (1..200)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
