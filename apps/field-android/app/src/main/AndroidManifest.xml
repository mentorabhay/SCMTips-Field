<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Meta Wearables DAT talks to the glasses over Bluetooth through the Meta AI app -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Only for the phone-microphone fallback; glasses speech needs the DAT MICROPHONE permission instead -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M3 work session: a foreground service that listens through the glasses with the phone in a pocket
         (Android 14+ needs the type permissions; the microphone is used only while a session is open, A-03) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Bluetooth hands-free (SCO) routing of the glasses microphone to the speech recogniser -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Tower check-in: the platform LocationManager (GPS + network), asked for at the check-in step -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- M5: the phone camera app for a look photo when the glasses give none -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".FieldApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="SCMTips Field"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="${mwdat_application_id}" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="${mwdat_client_token}" />
        <!-- ML Kit: download the barcode model at install time (also works with the bundled model) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Callback from the Meta AI app after glasses registration -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scmtipsfield" />
            </intent-filter>
        </activity>

        <!-- M5: the phone camera app writes a look photo into this app's cache (res/xml/look_files.xml) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.looks"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/look_files" />
        </provider>

        <service
            android:name=".session.WorkSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />
    </application>
</manifest>
