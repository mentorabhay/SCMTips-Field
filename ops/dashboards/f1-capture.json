      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "title": "field_lens_tick_ms (p50 / p90 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(field_lens_tick_ms_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(field_lens_tick_ms_bucket[5m])) by (le))",
          "legendFormat": "p90 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(field_lens_tick_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(field_lens_tick_ms_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency"
        },
        {
          "expr": "400",
          "legendFormat": "p95 Target Threshold (400ms)"
        }
      ]
    },
    {
      "collapsed": false,
