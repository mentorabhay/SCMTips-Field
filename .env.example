# Copy to .env.local (git-ignored) and fill in. Never commit real values (owner amendment A-02).
# scripts/dev/run-field-stack.ps1 creates .env.local from this file and generates the secrets for you.
FIELD_ENV=development
# App role: non-superuser, NOBYPASSRLS, so row-level security always applies.
FIELD_DATABASE_URL=postgresql://field_app:devpassword@127.0.0.1:5450/field
# Migrations / admin CLI only.
FIELD_ADMIN_DATABASE_URL=postgresql://postgres:dev-postgres-password@127.0.0.1:5450/field
FIELD_WORKER_DATABASE_URL=postgresql://field_worker:devpassword@127.0.0.1:5450/field
FIELD_ERP_SIM_URL=http://127.0.0.1:8002
ERPSIM_DATABASE_URL=postgresql://postgres:dev-postgres-password@127.0.0.1:5450/erpsim
# --- SCMTIPS core (M4 contract section 2; handover 01a) ----------------------------------------------------
# standin: the dev stack points every FIELD_CORE_* URL below at its stand-in core (tools/fake-core, a dev double,
#          not the SCMTIPS core) on FIELD_STACK_CORE_PORT (default 8011) and uses the generated feed secrets.
# core:    use the values below as set, e.g. the real core run locally on http://127.0.0.1:8000.
# (unset): pre-M4 behaviour: fake-core's /.well-known/jwks.json, no core device check, no goods-receipt feeds.
FIELD_CORE_TARGET=standin
# With FIELD_CORE_TARGET=core fill these (real core run locally: http://127.0.0.1:8000). Empty: field-api defaults to
# http://127.0.0.1:8011 and {FIELD_CORE_BASE_URL}/v1/core/jwks.json, and asks no core device status.
FIELD_CORE_BASE_URL=
FIELD_CORE_JWKS_URL=
# Template; {tenant_id} comes from the token, e.g. http://127.0.0.1:8000/v1/core/devices/{device_id}/status?tenant_id={tenant_id}
FIELD_CORE_DEVICE_STATUS_URL=
# Goods receipts (GR 101) -> the core's two webhook feeds (upsert). Nothing is sent unless both URLs are set.
# Real core: {CORE}/v1/inbound/feeds/<feed id>; each secret is shown once by the core when the feed is made.
FIELD_CORE_INVENTORY_FEED_URL=
FIELD_CORE_INVENTORY_FEED_SECRET=
FIELD_CORE_SUPPLY_FEED_URL=
FIELD_CORE_SUPPLY_FEED_SECRET=
# Optional: dead-letter after N tries (8), JSON file mapping ERP codes to core codes (materials / locations),
# send sandbox (home) receipts too (false).
FIELD_CORE_FEED_MAX_ATTEMPTS=8
FIELD_CORE_CODE_MAP=
FIELD_CORE_FEED_SANDBOX=false
# Stand-in core only (dev values): demo password and phone step-up code; empty = the defaults `stack up` prints.
FAKE_CORE_DEMO_PASSWORD=
FAKE_CORE_STEP_UP_CODE=
# Dev: import new inbound deliveries every 10 s (production default 300 s)
FIELD_IBD_POLL_S=10

# Signing keys (>= 32 bytes each). No defaults exist in code; generate random values.
FIELD_JWT_SECRET=
FIELD_CURSOR_HMAC_SECRET=
FIELD_P13F_WEBHOOK_SECRET=
FIELD_EVIDENCE_SECRET=

# Optional cloud AI fallback (off by default; on-device perception is primary)
AI_CLOUD_ENABLED=false
LLAMA_API_KEY=
BASETEN_API_KEY=
AI_BUDGET_LLAMA_USD=40
AI_BUDGET_BASETEN_USD=25
AI_DAILY_CAP_USD=3
# M3 Field Assistant (docs/design/M3_CONTRACT.md §4): Meta Model API; model ASSISTANT_MODEL (M4 default muse-spark-1.3). Without a key, a cap or
# AI_CLOUD_ENABLED=true the assistant answers in rules mode. Owner: set the cap you want to risk.
MODEL_API_KEY=
AI_BUDGET_META_USD=60
# Optional Baseten fallback (OpenAI-compatible); used only when both are set and the model is priced in config/ai_pricing.yaml
BASETEN_BASE_URL=
BASETEN_MODEL_ID=
