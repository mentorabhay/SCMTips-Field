# Copy to .env.local (git-ignored) and fill in. Never commit real values (owner amendment A-02).
# scripts/dev/run-field-stack.ps1 creates .env.local from this file and generates the secrets for you.
FIELD_ENV=development
# App role: non-superuser, NOBYPASSRLS, so row-level security always applies.
FIELD_DATABASE_URL=postgresql://field_app:devpassword@127.0.0.1:5450/field
# Migrations / admin CLI only.
FIELD_ADMIN_DATABASE_URL=postgresql://postgres:dev-postgres-password@127.0.0.1:5450/field
FIELD_WORKER_DATABASE_URL=postgresql://field_worker:devpassword@127.0.0.1:5450/field
FIELD_ERP_SIM_URL=http://127.0.0.1:8002
ERPSIM_DATABASE_URL=postgresql://postgres:dev-postgres-password@127.0.0.1:5450/erpsim
# --- Dev stack ports (tools/dev_stack/stack.py) -------------------------------------------------------------
# field-api listens on 8020 (the SCMTIPS core API keeps 8000 on this PC, its kit also 8001 and 8790, its web 3100).
# Empty = the default; if a default port is taken, `stack up` uses the next free one and prints it.
FIELD_STACK_API_PORT=
FIELD_STACK_ERPSIM_PORT=
FIELD_STACK_CORE_PORT=
# --- SCMTIPS core (M4 contract section 2; handover 01a; the core's reply TO_FIELD of 31 Oct) -------------------
# standin: the dev stack points every FIELD_CORE_* URL below at its stand-in core (tools/fake-core, a dev double,
#          not the SCMTIPS core) on FIELD_STACK_CORE_PORT (default 8011) and uses the generated feed secrets.
# core:    use the values below as set: the real core API on this PC's LAN address, port 8000, so the phone on the
#          same Wi-Fi reaches the same address (http://<LAN address of this PC>:8000; no real value here).
# (unset): pre-M4 behaviour: fake-core's /.well-known/jwks.json, no core device check, no goods-receipt feeds.
FIELD_CORE_TARGET=standin
# With FIELD_CORE_TARGET=core fill these, e.g. FIELD_CORE_BASE_URL=http://<LAN address>:8000 and
# FIELD_CORE_JWKS_URL=http://<LAN address>:8000/v1/core/jwks.json. Empty: field-api defaults to
# http://127.0.0.1:8011 and {FIELD_CORE_BASE_URL}/v1/core/jwks.json, and asks no core device status.
FIELD_CORE_BASE_URL=
FIELD_CORE_JWKS_URL=
# Template; {tenant_id} comes from the token, e.g.
# http://<LAN address>:8000/v1/core/devices/{device_id}/status?tenant_id={tenant_id}
FIELD_CORE_DEVICE_STATUS_URL=
# Core role key -> Field role(s), laid over the default table (approver -> field.supervisor, procurement ->
# field.operator, ops_lead/team_lead -> field.supervisor, org_admin -> field.admin, integration -> field.integration,
# planner/analyst -> field.viewer). A JSON object or the path of a JSON file, e.g. {"buyer": "field.operator"};
# [] removes a key. Empty = the default table. A token whose roles map to nothing is refused (FIELD-AUTH-403-NO-FIELD-ROLE).
FIELD_CORE_ROLE_MAP=
# Goods receipts (GR 101) -> the core's two webhook feeds (upsert). Nothing is sent unless both URLs are set.
# Real core: {CORE}/v1/inbound/feeds/<feed id>; each secret is shown once by the core when the feed is made.
FIELD_CORE_INVENTORY_FEED_URL=
FIELD_CORE_INVENTORY_FEED_SECRET=
FIELD_CORE_SUPPLY_FEED_URL=
FIELD_CORE_SUPPLY_FEED_SECRET=
# Optional: dead-letter after N tries (8), JSON file mapping ERP codes to core codes (materials / locations /
# purchase_orders: erp-sim PO number -> the core's PO number, e.g. {"4500001234": "PO-26-1001"}; an unmapped PO
# number is sent unchanged and logged), send sandbox (home) receipts too (false).
FIELD_CORE_FEED_MAX_ATTEMPTS=8
FIELD_CORE_CODE_MAP=
FIELD_CORE_FEED_SANDBOX=false
# The ERP snapshot (M4 Q10): every N seconds (0 = off) the changed rows of erp-sim's stock and open POs of the
# production sites' plants go to the same two feeds, at most BATCH rows per push; a row already sent is sent again
# after RESEND_H hours. TENANTS: comma-separated Field tenant ids to read (empty = all); with FIELD_CORE_TARGET=core
# name the core organisation's tenant, so the stack's demo tenant never reaches the real core.
# The drone world: `stack seed-core-export <SCMTips>/samples/exports/erp-sim` loads the core's export with its own codes
# (no FIELD_CORE_CODE_MAP for them) and creates the Field sites of its field-site-pack.
FIELD_CORE_SNAPSHOT_INTERVAL_S=900
FIELD_CORE_SNAPSHOT_BATCH=200
FIELD_CORE_SNAPSHOT_RESEND_H=24
FIELD_CORE_SNAPSHOT_TENANTS=
# Real-core smokes only (`stack smoke --core` / `--approver` with FIELD_CORE_TARGET=core, M4-C13): the core's demo
# members (from the core kit's `uv run scmtips-local-demo --with-team`, then `--print`); values only in .env.local.
# OPERATOR = a procurement member, APPROVER = an approver, ADMIN = the Org admin (creates the Field site of the core's
# organisation), PLANNER = a planner (opens a decision on the sample scenarios when none waits). The GR is posted
# against one of the core's PO lines: when erp-sim was seeded from the core's export, its own PO of that ref (export
# mode; FIELD_CORE_SMOKE_PO = the core's ref picks one), else an erp-sim PO named in FIELD_CORE_CODE_MAP
# purchase_orders (FIELD_CORE_SMOKE_PO picks one; default the first), whose core PO line's item and location must map
# back through its materials and locations entries.
# FIELD_CORE_SMOKE_APPROVER_TOTP_SECRET only when the core asks for a step-up (strict sign-in on).
FIELD_CORE_SMOKE_OPERATOR=
FIELD_CORE_SMOKE_OPERATOR_PASSWORD=
FIELD_CORE_SMOKE_APPROVER=
FIELD_CORE_SMOKE_APPROVER_PASSWORD=
FIELD_CORE_SMOKE_ADMIN=
FIELD_CORE_SMOKE_ADMIN_PASSWORD=
FIELD_CORE_SMOKE_PLANNER=
FIELD_CORE_SMOKE_PLANNER_PASSWORD=
# `stack smoke --approver --scenario <name>` (M4-C16): the core checkout's scenario pack folder (samples/scenarios of
# the SCMTIPS core, e.g. <workspace>\ARO\samples\scenarios); the scenario's SAMPLE signal file is read from there and
# sent to the core's own file-mode API, never copied into this repository.
FIELD_CORE_SCENARIOS_DIR=
FIELD_CORE_SMOKE_PO=
FIELD_CORE_SMOKE_APPROVER_TOTP_SECRET=
# Stand-in core only (dev values): demo password and phone step-up code; empty = the defaults `stack up` prints.
FAKE_CORE_DEMO_PASSWORD=
FAKE_CORE_STEP_UP_CODE=
# Dev: import new inbound deliveries every 10 s (production default 300 s)
FIELD_IBD_POLL_S=10

# Signing keys (>= 32 bytes each). No defaults exist in code; generate random values.
FIELD_JWT_SECRET=
FIELD_CURSOR_HMAC_SECRET=
FIELD_P13F_WEBHOOK_SECRET=
FIELD_EVIDENCE_SECRET=

# Optional cloud AI fallback (off by default; on-device perception is primary)
AI_CLOUD_ENABLED=false
LLAMA_API_KEY=
BASETEN_API_KEY=
AI_BUDGET_LLAMA_USD=40
AI_BUDGET_BASETEN_USD=25
AI_DAILY_CAP_USD=3
# M3 Field Assistant (docs/design/M3_CONTRACT.md §4): Meta Model API; model ASSISTANT_MODEL (M4 default muse-spark-1.3). Without a key, a cap or
# AI_CLOUD_ENABLED=true the assistant answers in rules mode. Owner: set the cap you want to risk.
MODEL_API_KEY=
AI_BUDGET_META_USD=60
# M5-W01 console "Try a look": try looks may spend at most this per tenant per UTC day (on top of the caps above),
# and each signed-in person may run FIELD_TRY_LOOKS_PER_HOUR looks per rolling hour. Try photos live 24 h here.
AI_TRY_DAILY_CAP_USD=3
FIELD_TRY_LOOKS_PER_HOUR=10
FIELD_TRY_PHOTO_DIR=var/try-photos
# Optional Baseten fallback (OpenAI-compatible); used only when both are set and the model is priced in config/ai_pricing.yaml
BASETEN_BASE_URL=
BASETEN_MODEL_ID=
