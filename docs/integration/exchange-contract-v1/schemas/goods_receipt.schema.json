{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scmtips:exchange:v1:goods_receipt",
  "title": "SCMTIPS Goods receipt (scmtips.exchange/v1)",
  "description": "Parts received against a purchase order, posted by the ERP after the warehouse captures them. It becomes one stock row and one PO row of the ERP extract.",
  "x-direction": "in",
  "x-legs": [
    "I10"
  ],
  "x-file-import": true,
  "type": "object",
  "required": [
    "contract",
    "message",
    "message_id",
    "rows"
  ],
  "properties": {
    "contract": {
      "const": "scmtips.exchange/v1"
    },
    "message": {
      "const": "goods_receipt"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,200}$",
      "description": "Idempotency key: a repeated id changes nothing."
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The SCMTIPS decision id, for the audit trail."
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "The sending system, e.g. naradcue, sangamiq, erp."
    },
    "sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "simulated": {
      "type": "boolean",
      "default": false,
      "description": "Test data; shown labelled SIMULATED."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "po_ref",
          "item_code",
          "location_code",
          "received_qty",
          "on_hand_after_qty",
          "received_at"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 100,
            "description": "The sender's unique id for this event; a repeat changes nothing."
          },
          "decision_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The SCMTIPS decision this row belongs to."
          },
          "po_ref": {
            "type": "string",
            "maxLength": 64,
            "description": "PO number and line, e.g. 4500001234-10."
          },
          "item_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "location_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "received_qty": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Number"
          },
          "on_hand_after_qty": {
            "type": "number",
            "minimum": 0,
            "description": "The ERP's on-hand after the receipt (absolute, not the change)."
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time, ISO 8601 with a time zone, e.g. 2026-11-03T09:30:00Z"
          },
          "supplier_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "The capture's id in the Field app."
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "Text"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "examples": [
    {
      "contract": "scmtips.exchange/v1",
      "message": "goods_receipt",
      "message_id": "example-goods_receipt-0001",
      "correlation_id": "3f2b8c1e-7a4d-4e1b-9c55-2d6f0a9b1e47",
      "source_system": "partner",
      "sent_at": "2026-11-03T12:00:00Z",
      "rows": [
        {
          "event_id": "erp-gr-5000000871",
          "decision_id": "3f2b8c1e-7a4d-4e1b-9c55-2d6f0a9b1e47",
          "po_ref": "4500001234-10",
          "item_code": "RM-307",
          "location_code": "PLANT-GOA",
          "received_qty": 120,
          "on_hand_after_qty": 420,
          "received_at": "2026-11-03T11:40:00Z",
          "evidence_ref": "cap-7f3a"
        }
      ]
    }
  ]
}
