{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scmtips:exchange:v1:work_order",
  "title": "SCMTIPS Work order (scmtips.exchange/v1)",
  "description": "One row per line of the execution orders an approved decision releases: production, purchase and transfer orders, checked against resource availability.",
  "x-direction": "out",
  "x-legs": [
    "I6",
    "I8"
  ],
  "x-file-import": true,
  "type": "object",
  "required": [
    "contract",
    "message",
    "message_id",
    "rows"
  ],
  "properties": {
    "contract": {
      "const": "scmtips.exchange/v1"
    },
    "message": {
      "const": "work_order"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,200}$",
      "description": "Idempotency key: a repeated id changes nothing."
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The SCMTIPS decision id, for the audit trail."
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "The sending system, e.g. naradcue, sangamiq, erp."
    },
    "sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "simulated": {
      "type": "boolean",
      "default": false,
      "description": "Test data; shown labelled SIMULATED."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order_id",
          "order_number",
          "order_kind",
          "decision_id",
          "action_id",
          "line_no",
          "item_code",
          "qty",
          "due_date",
          "status"
        ],
        "properties": {
          "release_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Identifier (UUID), e.g. 3f2b8c1e-7a4d-4e1b-9c55-2d6f0a9b1e47"
          },
          "order_id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier (UUID), e.g. 3f2b8c1e-7a4d-4e1b-9c55-2d6f0a9b1e47"
          },
          "order_number": {
            "type": "string",
            "maxLength": 64,
            "description": "Text"
          },
          "order_kind": {
            "type": "string",
            "enum": [
              "production",
              "purchase",
              "transfer"
            ],
            "description": "One of the allowed values"
          },
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "description": "The SCMTIPS decision this row answers."
          },
          "action_id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier (UUID), e.g. 3f2b8c1e-7a4d-4e1b-9c55-2d6f0a9b1e47"
          },
          "priority": {
            "type": [
              "number",
              "null"
            ],
            "description": "Number"
          },
          "line_no": {
            "type": "integer",
            "minimum": 1,
            "description": "Whole number"
          },
          "change": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "description": "Text"
          },
          "item_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "qty": {
            "type": "number",
            "description": "Number"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "Date, YYYY-MM-DD"
          },
          "resource_code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "Resources joined with +."
          },
          "hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Number"
          },
          "overtime_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Number"
          },
          "operations": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000,
            "description": "JSON list of operations."
          },
          "from_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Date, YYYY-MM-DD"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "description": "Text"
          },
          "supplier_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "site_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "lane_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "from_location": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "to_location": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/#&+()-]{0,63}$",
            "description": "Code (letters, digits, . _ / -; stored upper-case)"
          },
          "previous": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000,
            "description": "JSON of the values before the change."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "checked",
              "released",
              "acknowledged",
              "started",
              "completed",
              "cancelled",
              "failed"
            ],
            "description": "One of the allowed values"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "examples": [
    {
      "contract": "scmtips.exchange/v1",
      "message": "work_order",
      "message_id": "example-work_order-0001",
      "correlation_id": "3f2b8c1e-7a4d-4e1b-9c55-2d6f0a9b1e47",
      "source_system": "scmtips",
      "sent_at": "2026-11-03T12:00:00Z",
      "rows": [
        {
          "order_id": "8d1e6f0a-2b3c-4d5e-8f90-1a2b3c4d5e6f",
          "order_number": "EO-0012",
          "order_kind": "production",
          "decision_id": "3f2b8c1e-7a4d-4e1b-9c55-2d6f0a9b1e47",
          "action_id": "5a6b7c8d-9e0f-4a1b-8c2d-3e4f5a6b7c8d",
          "priority": 1,
          "line_no": 1,
          "change": "expedite",
          "item_code": "SA-120",
          "qty": 400,
          "due_date": "2026-11-20",
          "resource_code": "RES-SMT",
          "hours": 36,
          "status": "released"
        }
      ]
    }
  ]
}
