# SCMTips Field on a hosted server next to the SCMTIPS core (VM-1 of the hosting plan: api.scmtips.com for the core,
# field.scmtips.com for field-api, hud.scmtips.com for the console). Settings by NAME; secrets stay empty here and
# come from the host's secret store (Secret Manager -> /opt/scmtips/.env, owner amendment A-02). Images:
# deploy/docker/field.Dockerfile (field-api, field-worker, erp-sim), deploy/docker/console.Dockerfile (console),
# deploy/hosted/ops.Dockerfile (seeding and smokes). The hosting kit's compose file wires these per container.
FIELD_ENV=production
FIELD_PORT=8020
# --- databases (one Postgres 16; the kit's db-init creates the roles: field_app and field_worker are NOBYPASSRLS) -----
# FIELD_DATABASE_URL=postgresql://field_app:<FIELD_APP_DB_PASSWORD>@postgres:5432/field
# FIELD_WORKER_DATABASE_URL=postgresql://field_worker:<FIELD_WORKER_DB_PASSWORD>@postgres:5432/field
# FIELD_ADMIN_DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/field   (migrations, ops image)
# ERPSIM_DATABASE_URL=postgresql://erpsim_app:<ERPSIM_DB_PASSWORD>@postgres:5432/erpsim
FIELD_APP_DB_PASSWORD=
FIELD_WORKER_DB_PASSWORD=
ERPSIM_DB_PASSWORD=
# --- the SCMTIPS core (M4 contract section 2) ---------------------------------------------------------------------
FIELD_CORE_TARGET=core
FIELD_CORE_BASE_URL=https://api.scmtips.com
FIELD_CORE_JWKS_URL=https://api.scmtips.com/v1/core/jwks.json
FIELD_CORE_DEVICE_STATUS_URL=https://api.scmtips.com/v1/core/devices/{device_id}/status?tenant_id={tenant_id}
# On the same host as the core, the internal address avoids a round trip through DNS and TLS:
# FIELD_CORE_BASE_URL=http://api:8000 (and the JWKS / device-status / feed URLs on the same base).
FIELD_CORE_ROLE_MAP=
# The core organisation Field serves (its tenant id): the ERP snapshot and the goods-receipt feeds send only its rows.
# Required with FIELD_CORE_TARGET=core (the worker sends nothing and logs FIELD_CORE_FEED_TENANTS otherwise).
FIELD_CORE_SNAPSHOT_TENANTS=
FIELD_CORE_FEED_TENANTS=
# Goods receipts and the ERP snapshot -> the core's two webhook feeds; <feed id> and the secrets are shown once by the
# core when the feeds are made (Settings, Data feeds). Nothing is sent while either URL is empty.
FIELD_CORE_INVENTORY_FEED_URL=https://api.scmtips.com/v1/inbound/feeds/<inventory feed id>
FIELD_CORE_INVENTORY_FEED_SECRET=
FIELD_CORE_SUPPLY_FEED_URL=https://api.scmtips.com/v1/inbound/feeds/<open-supply feed id>
FIELD_CORE_SUPPLY_FEED_SECRET=
FIELD_CORE_FEED_SANDBOX=false
FIELD_CORE_SNAPSHOT_INTERVAL_S=900
# --- field-api's public address (the phone app, the pairing QR of `stack pair`) --------------------------------------
FIELD_PUBLIC_URL=https://field.scmtips.com
# --- the ERP simulator: internal only (the kit publishes it at erp.scmtips.com behind basic auth) --------------------
FIELD_ERP_ADAPTER=sim
FIELD_ERP_SIM_URL=http://erp-sim:8002
ERPSIM_ADMIN_TOKEN=
# --- signing keys (>= 32 bytes each, no defaults in code) -----------------------------------------------------------
FIELD_JWT_SECRET=
FIELD_CURSOR_HMAC_SECRET=
FIELD_P13F_WEBHOOK_SECRET=
FIELD_EVIDENCE_SECRET=
# --- the Field Assistant: Meta Model API only, through the server-side budget guard (hosting plan section 8) ---------
AI_CLOUD_ENABLED=true
MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
ASSISTANT_MODEL=muse-spark-1.3
ASSISTANT_MAX_OUTPUT_TOKENS=1024
AI_BUDGET_META_USD=100
AI_DAILY_CAP_USD=10
# No Baseten / Llama fallback on the hosted stack (Meta-only rule): leave these empty.
BASETEN_BASE_URL=
BASETEN_MODEL_ID=
BASETEN_API_KEY=
LLAMA_API_KEY=
# --- data folders (volumes) ----------------------------------------------------------------------------------------
FIELD_ASSISTANT_PHOTO_DIR=/data/assistant-photos
FIELD_CROP_DIR=/data/crops
# --- the ops image on the host (seed-core-export, smokes): the services by their container names --------------------
FIELD_STACK_API_URL=http://field-api:8020
FIELD_STACK_ERPSIM_URL=http://erp-sim:8002
